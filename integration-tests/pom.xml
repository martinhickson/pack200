<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.pack200</groupId>
  <artifactId>pack200-it</artifactId>
  <version>11.0.4</version>
  <packaging>jar</packaging>

  <name>Pack200 signed-jar integration tests</name>
  <description>
    Failsafe tests: JDK 11 pack200 --repack (normalize), sign third-party jars
    with io.github.martinhickson:webstart-maven-plugin, pack with JDK 11
    pack200, unpack with io.pack200, verify signatures.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <pack200.version>11.0.4</pack200.version>
    <webstart.plugin.version>1.2.4-bravura</webstart.plugin.version>
    <it.libDirectory>${project.build.directory}/it-lib</it.libDirectory>
    <jnlp.workDirectory>${project.build.directory}/jnlp</jnlp.workDirectory>
    <it.keystore>${project.build.directory}/keystore</it.keystore>
    <it.storepass>changeit</it.storepass>
    <it.alias>pack200-it</it.alias>
  </properties>

  <dependencies>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.16.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.14.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.13</version>
    </dependency>
    <dependency>
      <groupId>io.github.martinhickson</groupId>
      <artifactId>pack200</artifactId>
      <version>${pack200.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>enforce-jdk11-pack200-tool</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[11,12)</version>
                  <message>integration-tests need JDK 11 so ${java.home}/bin/pack200 exists.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-third-party-jars</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${it.libDirectory}</outputDirectory>
              <includeScope>runtime</includeScope>
              <excludeTransitive>true</excludeTransitive>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>jdk11-repack-normalize</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>io.pack200.it.Jdk11Pack200</mainClass>
              <arguments>
                <argument>repack</argument>
                <argument>${it.libDirectory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>io.github.martinhickson</groupId>
        <artifactId>webstart-maven-plugin</artifactId>
        <version>${webstart.plugin.version}</version>
        <executions>
          <execution>
            <id>sign-normalized-jars</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>jnlp-inline</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <workDirectory>${jnlp.workDirectory}</workDirectory>
          <excludeTransitive>true</excludeTransitive>
          <unsignAlreadySignedJars>true</unsignAlreadySignedJars>
          <gzip>true</gzip>
          <!-- pack then unpack before sign, same as pack200 -repack -->
          <pack200>
            <enabled>true</enabled>
            <commonsCompressEnabled>false</commonsCompressEnabled>
          </pack200>
          <jnlp>
            <outputFile>launch.jnlp</outputFile>
            <mainClass>io.pack200.it.UnpackFixture</mainClass>
          </jnlp>
          <sign>
            <keystore>${it.keystore}</keystore>
            <keypass>${it.storepass}</keypass>
            <storepass>${it.storepass}</storepass>
            <alias>${it.alias}</alias>
            <keyalg>RSA</keyalg>
            <validity>365</validity>
            <dnameCn>pack200-it.example</dnameCn>
            <dnameOu>pack200-it</dnameOu>
            <dnameO>Example</dnameO>
            <dnameL>Example</dnameL>
            <dnameSt>Example</dnameSt>
            <dnameC>US</dnameC>
            <verify>true</verify>
            <keystoreConfig>
              <delete>true</delete>
              <gen>true</gen>
            </keystoreConfig>
          </sign>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.1.2</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <jnlp.workDirectory>${jnlp.workDirectory}</jnlp.workDirectory>
            <it.keystore>${it.keystore}</it.keystore>
            <it.storepass>${it.storepass}</it.storepass>
            <it.alias>${it.alias}</it.alias>
            <it.workDirectory>${project.build.directory}/it-work</it.workDirectory>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
